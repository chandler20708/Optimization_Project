library(polars)
csv_file = './data/dft_traffic_counts_raw_counts.csv'
q <- (
pl
$scan_csv(csv_file, null_values='NULL')
$filter(pl$col('local_authority_name')$str$contains('Kent') & (pl$col('road_name') == 'A2' | pl$col('road_name') == 'A20' | pl$col('road_name') == 'M20'))
$select('road_name')
$unique()
)
q$collect()
