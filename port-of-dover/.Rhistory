install.packages('polars')
Sys.setenv(NOT_CRAN = "true")
install.packages("polars", repos = "https://community.r-multiverse.org")
library(polars)
csv_file = './data/dft_traffic_counts_raw_counts.csv'
q <- (
pl
$scan_csv(csv_file)
)
q
q$collect()
library(polars)
csv_file = './data/dft_traffic_counts_raw_counts.csv'
q <- (
pl
$scan_csv(csv_file, null_values='NULL')
)
q$collect()
q$fetch(5)
q$collect()$head(5)
q$schema()
q$schema
q$collect_schema()
q['local_authority_name']$collect_schema()
q['local_authority_name']$collect()$head(5)
q$collect()
